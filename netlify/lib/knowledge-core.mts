import { getDatabase } from "@netlify/database";
const CHAT="gpt-4.1-mini", EMB="text-embedding-3-small", MAXDOC=300000, MAXROWS=3000;
type Db=ReturnType<typeof getDatabase>;
const env=(n:string)=>{try{return Netlify.env.get(n)}catch{return undefined}};
const txt=(v:any)=>String(v??"").replace(/\r\n?/g,"\n").replace(/\u00a0/g," ").trim();
async function chat(messages:any[],json=false){const key=env("OPENAI_API_KEY"),base=env("OPENAI_BASE_URL"),model=env("HLK_MODEL")||CHAT;if(!key||!base)throw Error("AI_GATEWAY_UNAVAILABLE");const body:any={model,messages};if(json)body.response_format={type:"json_object"};const r=await fetch(`${base}/v1/chat/completions`,{method:"POST",headers:{"Content-Type":"application/json","Authorization":`Bearer ${key}`},body:JSON.stringify(body)});if(!r.ok)throw Error(`AI_GATEWAY_${r.status}`);const d:any=await r.json();return{text:txt(d.choices?.[0]?.message?.content),model}}
const obj=(s:string)=>JSON.parse(String(s||"").replace(/^```(?:json)?\s*/i,"").replace(/\s*```$/i,"").trim()||"{}");
function tokens(input:string){const s=txt(input).toLowerCase(),o=new Set<string>();for(const w of s.match(/[a-z0-9_.%+-]{2,}/g)||[])o.add(w);for(const q of s.match(/[\u4e00-\u9fa5]{2,}/g)||[]){if(q.length<=10)o.add(q);for(let n=2;n<=Math.min(3,q.length);n++)for(let i=0;i<=q.length-n;i++)o.add(q.slice(i,i+n))}return[...o].slice(0,260)}
function chunks(input:string,size=1800,overlap=220){const ps=txt(input).split(/\n+/).map(x=>x.trim()).filter(Boolean),out:string[]=[];let cur="";for(const p of ps){if(p.length>size){if(cur){out.push(cur);cur=""}for(let i=0;i<p.length;){const e=Math.min(p.length,i+size);out.push(p.slice(i,e));if(e===p.length)break;i=Math.max(0,e-overlap)}continue}const c=cur?`${cur}\n${p}`:p;if(c.length>size&&cur){out.push(cur);cur=`${cur.slice(-overlap)}\n${p}`}else cur=c}if(cur)out.push(cur);return out}
async function embeddings(inputs:string[]){if(!inputs.length)return{vectors:[],model:null};const key=env("OPENAI_API_KEY"),base=env("OPENAI_BASE_URL"),model=env("HLK_EMBEDDING_MODEL")||EMB;if(!key||!base||env("HLK_DISABLE_EMBEDDINGS")==="1")return{vectors:inputs.map(()=>null),model:null};try{const r=await fetch(`${base}/v1/embeddings`,{method:"POST",headers:{"Content-Type":"application/json","Authorization":`Bearer ${key}`},body:JSON.stringify({model,input:inputs})});if(!r.ok)return{vectors:inputs.map(()=>null),model:null};const d:any=await r.json(),m=new Map<number,number[]>();for(const x of d.data||[])if(Array.isArray(x.embedding))m.set(Number(x.index),x.embedding.map(Number));return{vectors:inputs.map((_,i)=>m.get(i)||null),model}}catch{return{vectors:inputs.map(()=>null),model:null}}}
function cosine(a:any,b:any){if(!a?.length||!b?.length||a.length!==b.length)return 0;let d=0,x=0,y=0;for(let i=0;i<a.length;i++){const p=+a[i]||0,q=+b[i]||0;d+=p*q;x+=p*p;y+=q*q}return x&&y?d/Math.sqrt(x*y):0}
async function expand(q:string){try{const r=await chat([{role:"system",content:'你是村级知识检索查询扩展器，只输出JSON：{"topic":"","terms":[]}。terms最多12个，加入可能出现在资料中的近义词、上下位词和行业表达，但不要生成事实。例如“蜂蜜生产”可扩展“蜂蜜/养蜂/中蜂/蜂群/蜜源/蜂业/产量”。'},{role:"user",content:q}],true),o=obj(r.text);return{topic:txt(o.topic)||q,terms:Array.from(new Set([q,...(Array.isArray(o.terms)?o.terms:[])].map(txt).filter(Boolean))).slice(0,16),model:r.model}}catch{return{topic:q,terms:[q],model:"none"}}}
function rowChunks(rows:any[],fields:string[],title:string){const out:any[]=[];for(let i=0;i<rows.length;i+=24){const b=rows.slice(i,i+24),lines=b.map((r,j)=>`${i+j+1}. ${(fields.length?fields:Object.keys(r||{})).map(f=>`${f}=${txt(r?.[f])}`).join("；")}`);out.push({text:`${title}\n${lines.join("\n")}`,meta:{kind:"structured_rows",row_start:i+1,row_end:i+b.length}})}return out}
export async function indexKnowledgeAsset(db:Db,id:string){const a=(await db.pool.query(`SELECT a.*,COALESCE(c.name,a.proposed_category) category FROM data_assets a LEFT JOIN reference_categories c ON c.category_id=a.category_id WHERE a.asset_id=$1 AND a.status='published' AND COALESCE(a.is_current,true)=true LIMIT 1`,[id])).rows[0];if(!a)return{ok:false,reason:"asset_not_published"};let defs:any[]=[];const meta={title:a.title,category:a.category,source:a.source_file_name,version:a.version_label,type:a.asset_type,published_at:a.published_at,updated_at:a.updated_at};if(a.asset_type==="document"){const body=txt(a.searchable_text).slice(0,MAXDOC);if(!body)return{ok:false,reason:"document_not_parsed"};defs=chunks(body).map((text,i)=>({text,meta:{...meta,kind:"document",chunk:i+1}}))}else if(a.asset_type==="structured"){const rs=(await db.pool.query(`SELECT data FROM data_asset_records WHERE asset_id=$1 ORDER BY row_no LIMIT $2`,[id,MAXROWS])).rows.map((x:any)=>x.data),fs=Array.isArray(a.fields)?a.fields.map(txt):[];defs=[{text:`资料：${a.title}\n分类：${a.category||""}\n说明：${a.description||""}\n字段：${fs.join("、")}\n记录数：${a.record_count||rs.length}`,meta:{...meta,kind:"structured_catalog"}},...rowChunks(rs,fs,a.title).map(x=>({text:x.text,meta:{...meta,...x.meta}}))]}else return{ok:false,reason:"unsupported_asset_type"};const vecs:any[]=[];let em:string|null=null;for(let i=0;i<defs.length;i+=16){const e=await embeddings(defs.slice(i,i+16).map(x=>x.text.slice(0,7000)));if(e.model)em=e.model;vecs.push(...e.vectors)}const c=await db.pool.connect();try{await c.query("BEGIN");await c.query(`DELETE FROM knowledge_chunks WHERE asset_id=$1`,[id]);for(let i=0;i<defs.length;i++)await c.query(`INSERT INTO knowledge_chunks(asset_id,dataset_id,chunk_index,section_title,chunk_text,search_tokens,embedding,embedding_model,metadata) VALUES($1,$2,$3,$4,$5,$6::text[],$7::double precision[],$8,$9::jsonb)`,[id,a.dataset_id||null,i+1,a.title,defs[i].text,tokens(`${a.title} ${a.category||""} ${defs[i].text}`),vecs[i]||null,em,JSON.stringify(defs[i].meta)]);await c.query(`INSERT INTO knowledge_index_state(asset_id,indexed_at,source_updated_at,chunk_count,embedding_model,status) VALUES($1,NOW(),$2,$3,$4,'ready') ON CONFLICT(asset_id) DO UPDATE SET indexed_at=NOW(),source_updated_at=EXCLUDED.source_updated_at,chunk_count=EXCLUDED.chunk_count,embedding_model=EXCLUDED.embedding_model,status='ready',last_error=NULL`,[id,a.updated_at||a.published_at||new Date().toISOString(),defs.length,em]);await c.query("COMMIT")}catch(e){await c.query("ROLLBACK");throw e}finally{c.release()}return{ok:true,chunks:defs.length,embedding_model:em}}
async function indexRows(db:Db,rows:any[]){const out:any[]=[];for(const r of rows){try{out.push({asset_id:r.asset_id,...await indexKnowledgeAsset(db,r.asset_id)})}catch(e:any){out.push({asset_id:r.asset_id,ok:false,reason:txt(e?.message)})}}return out}
export async function ensureKnowledgeIndex(db:Db,max=12){const rs=(await db.pool.query(`SELECT a.asset_id FROM data_assets a LEFT JOIN knowledge_index_state s ON s.asset_id=a.asset_id WHERE a.status='published' AND COALESCE(a.is_current,true)=true AND (a.asset_type='structured' OR (a.asset_type='document' AND COALESCE(length(a.searchable_text),0)>0)) AND (s.asset_id IS NULL OR s.status<>'ready' OR a.updated_at>COALESCE(s.source_updated_at,'1970-01-01'::timestamp)) ORDER BY a.updated_at DESC NULLS LAST LIMIT $1`,[max])).rows;return indexRows(db,rs)}
async function ensureRelevant(db:Db,terms:string[],max=28){const us=Array.from(new Set(terms.map(txt).filter(x=>x.length>=2))).slice(0,12);if(!us.length)return[];const ps:any[]=[],ors:string[]=[];for(const t of us){ps.push(`%${t}%`);const p=`$${ps.length}`;ors.push(`(a.title ILIKE ${p} OR COALESCE(a.description,'') ILIKE ${p} OR COALESCE(c.name,a.proposed_category,'') ILIKE ${p} OR COALESCE(a.fields::text,'') ILIKE ${p} OR COALESCE(a.searchable_text,'') ILIKE ${p})`)}ps.push(max);const rs=(await db.pool.query(`SELECT a.asset_id FROM data_assets a LEFT JOIN reference_categories c ON c.category_id=a.category_id LEFT JOIN knowledge_index_state s ON s.asset_id=a.asset_id WHERE a.status='published' AND COALESCE(a.is_current,true)=true AND (a.asset_type='structured' OR (a.asset_type='document' AND COALESCE(length(a.searchable_text),0)>0)) AND (s.asset_id IS NULL OR s.status<>'ready' OR a.updated_at>COALESCE(s.source_updated_at,'1970-01-01'::timestamp)) AND (${ors.join(" OR ")}) ORDER BY a.updated_at DESC NULLS LAST LIMIT $${ps.length}`,ps)).rows;return indexRows(db,rs)}
function lex(ct:string[],qt:string[]){const s=new Set(ct||[]);let n=0;for(const t of qt)if(s.has(t))n+=t.length>=3?1.6:1;return n/Math.max(2,Math.sqrt(qt.length||1))}
async function rerank(q:string,cs:any[]){try{const r=await chat([{role:"system",content:'你是知识检索重排序器，只输出JSON：{"scores":[{"id":1,"score":0}]}。score 0-100，越能直接回答问题越高。'},{role:"user",content:`问题：${q}\n候选：${JSON.stringify(cs.slice(0,30).map(x=>({id:x.chunk_id,title:x.title,text:txt(x.chunk_text).slice(0,850)})))}`}],true),o=obj(r.text),m=new Map<number,number>();for(const x of Array.isArray(o.scores)?o.scores:[])if(Number.isFinite(+x.id)&&Number.isFinite(+x.score))m.set(+x.id,Math.max(0,Math.min(100,+x.score))/100);return{scores:m,model:r.model}}catch{return{scores:new Map<number,number>(),model:"none"}}}
export async function searchKnowledge(db:Db,q:string,opt:{limit?:number;asset_id?:string|null}={}){const ex=await expand(q),rel=await ensureRelevant(db,ex.terms,28),recent=await ensureKnowledgeIndex(db,Math.max(0,6-rel.length)),indexed=[...rel,...recent.filter((x:any)=>!rel.some((y:any)=>y.asset_id===x.asset_id))],qt=tokens(ex.terms.join(" ")),vals:any[]=[];let wh=`a.status='published' AND COALESCE(a.is_current,true)=true`;if(opt.asset_id){vals.push(opt.asset_id);wh+=` AND kc.asset_id=$${vals.length}`}const lp=[...vals,qt],tp=`$${lp.length}`;const base=`SELECT kc.*,a.title,COALESCE(c.name,a.proposed_category) category,a.source_file_name,a.version_label,a.published_at,a.updated_at FROM knowledge_chunks kc JOIN data_assets a ON a.asset_id=kc.asset_id LEFT JOIN reference_categories c ON c.category_id=a.category_id`;const lr=(await db.pool.query(`${base} WHERE ${wh} AND kc.search_tokens && ${tp}::text[] ORDER BY a.updated_at DESC NULLS LAST LIMIT 180`,lp)).rows,qe=(await embeddings([q]));const qv=qe.vectors[0]||null;let sr:any[]=[];if(qv){sr=(await db.pool.query(`${base} WHERE ${wh} AND kc.embedding IS NOT NULL ORDER BY a.updated_at DESC NULLS LAST,kc.chunk_id DESC LIMIT 3000`,vals)).rows.map((r:any)=>({...r,semantic_score:cosine(qv,r.embedding)})).sort((a:any,b:any)=>b.semantic_score-a.semantic_score).slice(0,70)}const mm=new Map<number,any>();for(const r of lr)mm.set(+r.chunk_id,{...r,lexical_score:lex(r.search_tokens||[],qt),semantic_score:0});for(const r of sr){const e=mm.get(+r.chunk_id);if(e)e.semantic_score=Math.max(e.semantic_score||0,r.semantic_score||0);else mm.set(+r.chunk_id,{...r,lexical_score:lex(r.search_tokens||[],qt),semantic_score:r.semantic_score||0})}let cs=[...mm.values()].map((r:any)=>({...r,pre_score:Math.min(1,(r.lexical_score||0)/4)*.48+Math.max(0,r.semantic_score||0)*.52})).sort((a,b)=>b.pre_score-a.pre_score).slice(0,30),rr=await rerank(q,cs);cs=cs.map((r:any)=>{const z=rr.scores.get(+r.chunk_id);return{...r,final_score:z===undefined?r.pre_score:r.pre_score*.38+z*.62}}).sort((a,b)=>b.final_score-a.final_score);const lim=Math.min(20,Math.max(3,+opt.limit!||12)),pick:any[]=[],pa=new Map<string,number>();for(const r of cs){const n=pa.get(r.asset_id)||0;if(n>=4)continue;if(pick.length>=lim)break;pick.push(r);pa.set(r.asset_id,n+1)}const sm=new Map<string,any>();for(const r of pick){if(!sm.has(r.asset_id))sm.set(r.asset_id,{asset_id:r.asset_id,dataset_id:r.dataset_id,title:r.title,category:r.category,source_file_name:r.source_file_name,version_label:r.version_label,published_at:r.published_at,updated_at:r.updated_at,chunks:[],best_score:r.final_score});const s=sm.get(r.asset_id);s.chunks.push({chunk_id:r.chunk_id,chunk_index:r.chunk_index,text:r.chunk_text,metadata:r.metadata,score:r.final_score});s.best_score=Math.max(s.best_score,r.final_score)}return{query:q,expansion:ex,query_tokens:qt,embedding_used:!!qv,embedding_model:qe.model,rerank_used:rr.model!=="none",rerank_model:rr.model,indexed_assets:indexed,candidate_chunks:mm.size,matched_chunks:pick.length,matched_assets:sm.size,sources:[...sm.values()].sort((a,b)=>b.best_score-a.best_score)}}
export async function synthesizeKnowledgeAnswer(q:string,r:any){if(!r?.sources?.length)return{direct_answer:`当前已发布资料中没有找到足够内容回答“${q}”。`,sections:[],conflicts:[],claims:[],model:"none"};const ss=r.sources.map((s:any,i:number)=>({source_id:`S${i+1}`,asset_id:s.asset_id,title:s.title,category:s.category,version:s.version_label,published_at:s.published_at,updated_at:s.updated_at,excerpts:s.chunks.map((c:any)=>txt(c.text).slice(0,1800))}));try{const x=await chat([{role:"system",content:'你是黄林坑村治理AI多源知识融合器，只根据提供的已发布资料回答。输出JSON：{"direct_answer":"","sections":[{"title":"","items":[]}],"conflicts":[{"topic":"","details":[],"resolution":""}],"claims":[{"text":"","source_ids":[]}]}。互补信息融合、重复去重；数字/人数/金额/时间保持原值；冲突必须列出，不能平均或任选；有明确更新时间才可说明较新口径；结构化明确统计优先作为数值事实；每个关键claim列来源ID。'},{role:"user",content:`问题：${q}\n来源：${JSON.stringify(ss)}`}],true),o=obj(x.text);return{direct_answer:txt(o.direct_answer)||"已找到相关资料。",sections:(Array.isArray(o.sections)?o.sections:[]).slice(0,6),conflicts:(Array.isArray(o.conflicts)?o.conflicts:[]).slice(0,8),claims:(Array.isArray(o.claims)?o.claims:[]).slice(0,20),model:x.model,source_map:ss}}catch{return{direct_answer:`已找到 ${r.matched_assets} 份相关资料，但当前融合模型暂不可用。`,sections:[],conflicts:[],claims:[],model:"none",source_map:ss}}}
